<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos de Verano - Facultad Informática</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <header class="main-header">
        <!-- Header existente -->
    </header>

    <main class="cursos-container py-5">
        <!-- Sección Misión -->
        <section class="mision-section text-center mb-5">
            <div class="container">
                <h1 class="display-4 mb-4">Cursos de Verano 2025</h1>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <p class="lead mision-text">
                            Impulsando la próxima generación de innovadores tecnológicos a través de:
                        </p>
                        <div class="objetivos-grid row g-4">
                            <div class="col-md-6 col-lg-3">
                                <div class="objetivo-card p-3">
                                    <i class="fas fa-brain fa-2x mb-3"></i>
                                    <h5>Desarrollo Cognitivo</h5>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="objetivo-card p-3">
                                    <i class="fas fa-code fa-2x mb-3"></i>
                                    <h5>Programación Creativa</h5>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="objetivo-card p-3">
                                    <i class="fas fa-users fa-2x mb-3"></i>
                                    <h5>Trabajo en Equipo</h5>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-3">
                                <div class="objetivo-card p-3">
                                    <i class="fas fa-rocket fa-2x mb-3"></i>
                                    <h5>Innovación Tecnológica</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Sección de Cursos -->
        <section class="cursos-section">
            <div class="container">
                <h2 class="text-center mb-5">Nuestros Programas</h2>
                
                <!-- Acordeón de Cursos -->
                <div class="accordion" id="cursosAccordion">
                    <!-- Categoría 1: Principiantes -->
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#nivel1">
                                <i class="fas fa-seedling me-3"></i>
                                Nivel Básico (8-12 años)
                            </button>
                        </h3>
                        <div id="nivel1" class="accordion-collapse collapse show" data-bs-parent="#cursosAccordion">
                            <div class="accordion-body">
                                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                    <!-- Curso 1 -->
                                    <div class="col">
                                        <div class="curso-card h-100">
                                            <div class="curso-header">
                                                <h4>Introducción a la Programación</h4>
                                                <span class="badge bg-warning">Nuevo</span>
                                            </div>
                                            <div class="curso-body">
                                                <ul class="detalles-curso">
                                                    <li><i class="fas fa-clock"></i> 20 horas</li>
                                                    <li><i class="fas fa-users"></i> Grupos de 10</li>
                                                    <li><i class="fas fa-puzzle-piece"></i> Scratch & Blockly</li>
                                                </ul>
                                                <button class="btn btn-outline-dark btn-sm">Más información</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Más cursos... -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Categoría 2: Intermedio -->
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nivel2">
                                <i class="fas fa-chart-line me-3"></i>
                                Nivel Intermedio (13-17 años)
                            </button>
                        </h3>
                        <div id="nivel2" class="accordion-collapse collapse" data-bs-parent="#cursosAccordion">
                            <div class="accordion-body">
                                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                    <!-- Curso 1 -->
                                    <div class="col">
                                        <div class="curso-card h-100">
                                            <div class="curso-header">
                                                <h4>Desarrollo Web Junior</h4>
                                                <span class="badge bg-success">Popular</span>
                                            </div>
                                            <div class="curso-body">
                                                <ul class="detalles-curso">
                                                    <li><i class="fas fa-clock"></i> 40 horas</li>
                                                    <li><i class="fas fa-laptop-code"></i> HTML/CSS/JS</li>
                                                    <li><i class="fas fa-project-diagram"></i> Proyecto Final</li>
                                                </ul>
                                                <button class="btn btn-outline-dark btn-sm">Más información</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Más cursos... -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Categoría 3: Avanzado -->
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#nivel3">
                                <i class="fas fa-graduation-cap me-3"></i>
                                Nivel Avanzado (18+ años)
                            </button>
                        </h3>
                        <div id="nivel3" class="accordion-collapse collapse" data-bs-parent="#cursosAccordion">
                            <div class="accordion-body">
                                <div class="row row-cols-1 row-cols-md-2 g-4">
                                    <!-- Curso 1 -->
                                    <div class="col">
                                        <div class="curso-card h-100">
                                            <div class="curso-header">
                                                <h4>Inteligencia Artificial Básica</h4>
                                                <span class="badge bg-danger">Limitado</span>
                                            </div>
                                            <div class="curso-body">
                                                <ul class="detalles-curso">
                                                    <li><i class="fas fa-robot"></i> Python</li>
                                                    <li><i class="fas fa-brain"></i> Redes Neuronales</li>
                                                    <li><i class="fas fa-database"></i> TensorFlow</li>
                                                </ul>
                                                <button class="btn btn-outline-dark btn-sm">Inscribirse</button>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Más cursos... -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="main-footer">
        <!-- Footer existente -->
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/main.js"></script>
</body>
</html>